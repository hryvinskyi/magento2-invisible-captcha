use Hryvinskyi\InvisibleCaptcha\ViewModel\AjaxFallback;
use Hryvinskyi\ThemeAssets\Api\AssetRendererInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$viewModel = $block->getData('view_model');
$assetRenderer = $block->getData('asset_renderer');
if (!$viewModel instanceof AjaxFallback || !$assetRenderer instanceof AssetRendererInterface) {
    return;
}

// The script wraps XMLHttpRequest and fetch, so it loads synchronously in the
// head: requests the page's own scripts send before it ran would not be seen.
// It reads the configuration block printed right before it; the layout's
// script_attributes go on both tags, so whatever rewrites the response treats
// them alike.
$attributes = $viewModel->getScriptAttributes($block->getData('script_attributes'));
$attributeHtml = '';
foreach ($attributes as $name => $value) {
    $attributeHtml .= ' ' . $escaper->escapeHtmlAttr($name) . '="' . $escaper->escapeHtmlAttr($value) . '"';
}
?>
<script type="application/json" id="<?= /* @noEscape */ AjaxFallback::CONFIG_ELEMENT_ID ?>"<?= /* @noEscape */ $attributeHtml ?>><?= /* @noEscape */ $viewModel->getConfigJson() ?></script>
<?= /* @noEscape */ $assetRenderer->renderScript(
    AjaxFallback::SCRIPT_FILE_ID,
    AssetRendererInterface::RENDER_EXTERNAL,
    AssetRendererInterface::LOAD_SYNC,
    AssetRendererInterface::PRELOAD_DISABLED,
    [],
    ['attributes' => $attributes]
) ?>
