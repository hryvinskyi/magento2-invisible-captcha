use Hryvinskyi\InvisibleCaptcha\ViewModel\SilentVerification;
use Hryvinskyi\ThemeAssets\Api\AssetRendererInterface;
use Magento\Framework\View\Element\Template;

/** @var Template $block */

$viewModel = $block->getData('view_model');
$assetRenderer = $block->getData('asset_renderer');
if (!$viewModel instanceof SilentVerification
    || !$assetRenderer instanceof AssetRendererInterface
    || !$viewModel->isActive()
) {
    return;
}
?>
<script type="application/json" id="<?= /* @noEscape */ SilentVerification::CONFIG_ELEMENT_ID ?>"><?= /* @noEscape */ $viewModel->getConfigJson() ?></script>
<?= /* @noEscape */ $assetRenderer->renderScript(
    SilentVerification::SCRIPT_FILE_ID,
    AssetRendererInterface::RENDER_EXTERNAL,
    AssetRendererInterface::LOAD_DEFER
) ?>
