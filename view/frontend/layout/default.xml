<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template"
                   name="hryvinskyi.invisible_captcha.ajax.config"
                   template="Hryvinskyi_InvisibleCaptcha::ajax-config.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Hryvinskyi\InvisibleCaptcha\ViewModel\AjaxFallback</argument>
                    <argument name="asset_renderer" xsi:type="object">Hryvinskyi\ThemeAssets\Api\AssetRendererInterface</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="hryvinskyi.invisible_captcha.silent_verification"
                   template="Hryvinskyi_InvisibleCaptcha::silent-verification.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Hryvinskyi\InvisibleCaptcha\ViewModel\SilentVerification</argument>
                    <argument name="asset_renderer" xsi:type="object">Hryvinskyi\ThemeAssets\Api\AssetRendererInterface</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="footer">
            <block class="Hryvinskyi\InvisibleCaptcha\Block\CaptchaNewsletter" name="invisible.recaptcha.newsletter"
                   after="-" template="Hryvinskyi_InvisibleCaptcha::captcha_newsletter.phtml"
                   ifconfig="hryvinskyi_invisible_captcha/form_protection/frontend/enabled_newsletter">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="invisible-captcha-newsletter" xsi:type="array">
                                <item name="component" xsi:type="string">Hryvinskyi_InvisibleCaptcha/js/invisible-captcha</item>
                                <item name="action" xsi:type="string">newsletter</item>
                                <item name="captchaId" xsi:type="string">newsletter</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="authentication-popup">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="authenticationPopup" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="invisible-captcha" xsi:type="array">
                                    <item name="component" xsi:type="string">Hryvinskyi_InvisibleCaptcha/js/invisible-captcha</item>
                                    <item name="displayArea" xsi:type="string">additional-login-form-fields</item>
                                    <item name="configSource" xsi:type="string">checkoutConfig</item>
                                    <item name="action" xsi:type="string">customer_login_ajax</item>
                                    <item name="captchaId" xsi:type="string">customer_login_popup</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
